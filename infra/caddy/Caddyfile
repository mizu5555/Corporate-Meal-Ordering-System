{
	auto_https disable_redirects
}

http://localhost {
	redir https://localhost{uri}
}

https://localhost {
	tls internal

	handle /health {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	handle /vendor/* {
		reverse_proxy backend:8000
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
		header Cache-Control "public, max-age=3600"
	}

	handle {
		reverse_proxy frontend:80
	}
}
